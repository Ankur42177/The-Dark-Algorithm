# =====================================================================
# Copy this file to .env and change the values:   cp .env.example .env
# .env is git-ignored: real passwords NEVER go into git.
# Both Docker Compose and the Spring services read it.
# =====================================================================

# Postgres superuser (only used by the container and the init script)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# One login per service database
CONTENT_DB_USER=content
CONTENT_DB_PASSWORD=change-me-content
INGESTION_DB_PASSWORD=change-me-ingestion
ASSISTANT_DB_PASSWORD=change-me-assistant

DB_HOST=localhost
DB_PORT=5432

# ---- Phase 4: admin login ----
ADMIN_USERNAME=ankur
ADMIN_DISPLAY_NAME=Ankur Kumar
# ./scripts/hash-password.sh writes this (BCrypt hash, never the password):
ADMIN_PASSWORD_HASH=
# ./scripts/gen-jwt-keys.sh writes these (RSA key pair for signing JWTs):
PULSE_JWT_PRIVATE_KEY=
PULSE_JWT_PUBLIC_KEY=
