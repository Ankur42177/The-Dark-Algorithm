# Where the SERVER side of Next.js fetches data (build time + revalidation).
# Since Phase 5 everything goes through the api-gateway (8080). Note: all server-side fetches share ONE
# client IP at the gateway (public limit 60/min, burst 60) - fine for builds; see ADR-0009.
PULSE_API_URL=http://localhost:8080
# Where the BROWSER fetches "load more" pages (NEXT_PUBLIC_ = exposed to the browser bundle).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Shared secret that content-service sends to POST /api/revalidate (Phase 6). Change it!
REVALIDATE_SECRET=change-me-revalidate-secret
