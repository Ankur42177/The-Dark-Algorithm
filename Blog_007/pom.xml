<?xml version="1.0" encoding="UTF-8"?>
<!--
  PARENT POM for the whole Pulse backend (Maven multi-module project).
  Learning notes: Learning_project/phase-01-content-service/03-maven-explained.md

  A "parent POM" holds settings that every child module (service) shares:
  Java version, library versions, plugins. Each service's own pom.xml points
  back here with <parent>, so we change a version in ONE place.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Inherit from Spring Boot's own parent. This gives us:
        * a curated, tested set of library versions (Hibernate, Jackson, Flyway,
          PostgreSQL driver, Testcontainers ...) so we don't pick versions by hand
        * sensible plugin defaults (compiler, surefire for tests, etc.)
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <!-- Maven coordinates of THIS project: groupId:artifactId:version -->
    <groupId>com.pulse</groupId>
    <artifactId>pulse-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <!-- "pom" packaging = this module produces no jar; it only groups children -->
    <packaging>pom</packaging>
    <name>Pulse :: parent</name>
    <description>Learning-first microservices blog platform (Tech, Football, AI)</description>

    <!--
      Child modules. We add one per phase as we build them:
        Phase 1: content-service
        Phase 5: api-gateway
        Phase 6: libs/events
        Phase 7: ingestion-service
        Phase 8: assistant-service
    -->
    <modules>
        <module>services/content-service</module>
    </modules>

    <properties>
        <!-- Java 25 (LTS). spring-boot-starter-parent reads this property. -->
        <java.version>25</java.version>

        <!-- Versions of libraries that Spring Boot does NOT manage for us. -->
        <springdoc.version>3.1.1</springdoc.version>          <!-- built against Boot 4.1 -->
        <spring-cloud.version>2025.1.5</spring-cloud.version> <!-- used from Phase 5 -->
        <spring-ai.version>2.0.3</spring-ai.version>          <!-- used from Phase 8 -->
    </properties>

    <!--
      dependencyManagement = "IF a child asks for this library, use THIS version".
      It does not add the library to anybody by itself.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
