<?xml version="1.0" encoding="UTF-8"?>
<!--
  pulse-events: the shared EVENT CONTRACTS (Kafka message shapes) used by producers and consumers.
  Deliberately tiny: records + constants only, no business logic, no Spring. A shared library that grows
  logic turns microservices into a "distributed monolith" (every change forces every service to redeploy).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pulse</groupId>
        <artifactId>pulse-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>pulse-events</artifactId>
    <name>Pulse :: events (shared contracts)</name>
    <description>Event envelope and payload records shared by Pulse services. Designed and developed by Ankur Kumar · © 2026 Ravenclaw_007 LLC</description>
</project>
